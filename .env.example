# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL password (choose a strong random string)
POSTGRES_PASSWORD=change_me_strong_password

# Redis password
REDIS_PASSWORD=change_me_redis_password

# JWT signing secret — minimum 32 characters, keep this private
JWT_SECRET=change_me_min_32_chars_random_secret_here!!

# ─── Hostnames (Traefik routing) ─────────────────────────────────────────────
# Public hostnames matched by Traefik Host(`...`) labels.

FRONTEND_HOST=fa.example.com
BACKEND_HOST=api.fa.example.com

# Full public URLs derived from the hostnames above (no trailing slash).
# Used by the backend for CORS, OIDC redirect URI, and baked into the SPA build.

FRONTEND_URL=https://fa.example.com
BACKEND_URL=https://api.fa.example.com

# ─── Authentication ───────────────────────────────────────────────────────────

# OIDC (Authentik or any OIDC-compliant provider)
# Leave blank to disable OIDC and use local auth only
OIDC_ISSUER_URL=https://authentik.example.com/application/o/fantasia-archive/
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Local username/password login (useful for admin bootstrap or without OIDC)
# Set to "true" to enable the /auth/local/register and /auth/local/login endpoints
LOCAL_AUTH_ENABLED=false

# ─── Optional tuning ─────────────────────────────────────────────────────────

# JWT access token expiry in seconds (default: 900 = 15 minutes)
JWT_EXPIRY=900

# Refresh token expiry in days (default: 7)
REFRESH_TOKEN_EXPIRY_DAYS=7
